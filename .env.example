# Firebase Web App Config (From Firebase Console -> Project Settings -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=your_api_key_here
# In production set this to the deployed domain (e.g. your-app.vercel.app), not
# the firebaseapp.com domain. Add that domain to Firebase Auth authorized
# domains and add https://<domain>/__/auth/handler to the OAuth client's
# authorized redirect URIs. vercel.json proxies /__/auth/* to Firebase.
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Identity / Google One Tap Client ID
# (From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID for Web)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
